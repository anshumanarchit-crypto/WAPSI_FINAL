# ==============================================================================
# WAPSI Configuration Template (.env.example)
# Copy to .env and populate with your credentials. NEVER commit .env to Git!
# ==============================================================================

# Razorpay Credentials (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=

# WAPSI Service Security
WAPSI_ENV=development
WAPSI_API_KEY=
WAPSI_API_RATE_LIMIT=120
WAPSI_LOG_LEVEL=INFO

# Application Server
# Application Server & Public Webhook Tunnel
HOST=0.0.0.0
PORT=8000
MODELS_DIR=models
WAPSI_PUBLIC_BASE_URL=https://your-tunnel-subdomain.ngrok-free.dev

# Policy Engine Defaults
POLICY_DND_START_HOUR=21
POLICY_DND_END_HOUR=9
POLICY_MAX_DAILY_TOUCHES=2
POLICY_MIN_IVR_AMOUNT=1500.00

# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DIAGNOSTIC_TOKEN=
WHATSAPP_AUTH_MODE=system_user # Options: system_user (production default), dashboard_sandbox (sandbox testing only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Supabase & PostgreSQL Persistence (Phase 1B.5: WAPSI-DEV-MUMBAI, Region: ap-south-1)
# Note: For direct PostgreSQL, use transaction pooler (port 6543) or session pooler (port 5432)
# Example: postgresql://postgres.filofxijqmgluuulivxb:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=https://filofxijqmgluuulivxb.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CUSTOMER_HASH_SALT=

# LLM Providers for Synthetic Narrative Generation
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3



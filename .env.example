# ==============================================================================
# WAPSI Configuration Template (.env.example)
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# Razorpay Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# WAPSI Service Security
WAPSI_ENV=development
WAPSI_API_KEY=rzp_test_wapsi_key_2026
WAPSI_API_RATE_LIMIT=120
WAPSI_LOG_LEVEL=INFO

# Application Server & Public Webhook Tunnel
HOST=0.0.0.0
PORT=8000
MODELS_DIR=models
WAPSI_PUBLIC_BASE_URL=https://your-tunnel-subdomain.ngrok-free.dev

# Policy Engine Defaults
POLICY_DND_START_HOUR=21
POLICY_DND_END_HOUR=9
POLICY_MAX_DAILY_TOUCHES=2
POLICY_MIN_IVR_AMOUNT=1500.00

# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_DIAGNOSTIC_TOKEN=
WHATSAPP_AUTH_MODE=system_user # Options: system_user (production default), dashboard_sandbox (sandbox testing only)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
META_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v26.0

# Supabase & PostgreSQL Persistence (Region: ap-south-1)
# Direct connection / transaction pooler (port 6543) or session pooler (port 5432)
# Example: postgresql://postgres.your-project-ref:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CUSTOMER_HASH_SALT=your_customer_hash_salt
